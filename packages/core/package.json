{
  "name": "@jira-workbench/core",
  "version": "0.32.3",
  "private": true,
  "type": "module",
  "description": "Host-agnostic Jira/JXL/SVN business core shared by the Codex adapter and the DSH adapter.",
  "bin": {
    "jira-workbench-core": "bin/serve.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./config-store.mjs": "./config-store.mjs",
    "./jira-client.mjs": "./jira-client.mjs",
    "./jxl-client.mjs": "./jxl-client.mjs",
    "./lib/*.mjs": "./lib/*.mjs",
    "./mcp/*.mjs": "./mcp/*.mjs",
    "./public/*.js": "./public/*.js",
    "./mcp/ui/*.html": "./mcp/ui/*.html"
  },
  "scripts": {
    "serve": "node bin/serve.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
